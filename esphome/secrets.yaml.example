# Wi-Fi Credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback Hotspot Password (if Wi-Fi fails to connect)
ap_password: "YourFallbackPassword"

# ESPHome Native API Encryption Key (generate via: openssl rand -base64 32)
api_key: "IS6xS7yx4dtwuPXI0a0l/5qGB7iVluMsoxH4A441wWc="

# OTA Update Password
ota_password: "YourSecureOtaPassword"
